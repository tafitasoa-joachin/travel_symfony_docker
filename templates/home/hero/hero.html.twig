<div class="hero">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-lg-7">
				<div class="intro-wrap">
					<h1 class="mb-5">
						<span class="d-block">Profitons de votre voyage à</span>
						<span class="typed-words"></span>
					</h1>

					<div class="row">
						<div class="col-12">
							<form action="{{ path('offer_search') }}" method="POST" class="form">
								<div class="row mb-2">
									<div class="col-sm-12 col-md-6 mb-3 mb-lg-0 col-lg-6">
										<select name="destination" id="destination" class="form-control custom-select">
											{% for offer in offers %}
												<option value="{{ offer.destination }}">{{ offer.destination }}</option>
											{% endfor %}
										</select>
									</div>
									<div class="col-sm-12 col-md-6 mb-3 mb-lg-0 col-lg-6">
										<input type="submit" class="btn btn-primary btn-block" value="Rechercher">
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-5">
				<div class="slides">
					<img src="{{ asset('assets/images/hero-slider-1.jpg') }}" alt="Image" class="img-fluid active">
					<img src="{{ asset('assets/images/hero-slider-2.jpg') }}" alt="Image" class="img-fluid">
					<img src="{{ asset('assets/images/hero-slider-3.jpg') }}" alt="Image" class="img-fluid">
					<img src="{{ asset('assets/images/hero-slider-4.jpg') }}" alt="Image" class="img-fluid">
					<img src="{{ asset('assets/images/hero-slider-5.jpg') }}" alt="Image" class="img-fluid">
				</div>
			</div>
		</div>
	</div>
</div>
