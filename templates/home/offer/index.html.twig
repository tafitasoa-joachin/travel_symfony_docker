<div class="untree_co-section" id="offre">
	<div class="container">
		<div class="row text-center justify-content-center mb-5">
			<div class="col-lg-7">
				<h2 class="section-title text-center">Offres spéciales</h2>
			</div>
		</div>
		<div class="tab-content">
			<div class="row g-4">
				{% for offer in offers %}
					<div class="col-md-6 col-lg-4 col-xl-3 mt-4">
						<div class="rounded position-relative">
							<a href="{{ path('offer_detail', { 'id': offer.id })}}">
								<img src="uploads/{{ offer.illustration }}" class="img-fluid w-100 rounded-top" style="height:15rem;" alt="">
							</a>
							<div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">{{ offer.totalPrice|price }}</div>

							<div class="p-2 border border-top-0 rounded-bottom">
								<h4 class="text-center text-primary">{{ offer.destination }}</h4>
								<div class="d-flex justify-content-between flex-lg-wrap">
									<p>Date de départ:</p>
									<p>{{ offer.departureDate|date('d/m/y') }}</p>
								</div>
								<div class="d-flex justify-content-between flex-lg-wrap">
									<p>Date d'arrivée:</p>
									<p>{{ offer.arrivalDate|date('d/m/y') }}</p>
								</div>
								<p class="text-dark fs-5 fw-bold mb-0">{{ offer.availableSeats }}
									personnes</p>
								<button class="btn btn-primary w-100 mt-2" data-toggle="modal" data-target="#reserveModal{{ offer.id }}" onclick="loadReservationForm({{ offer.id }})">Réserver</button>

								{# Modal unique pour chaque offre #}
								<div class="modal fade" id="reserveModal{{ offer.id }}" tabindex="-1" role="dialog" aria-labelledby="reserveModalLabel{{ offer.id }}" aria-hidden="true">
									<div class="modal-dialog" role="document">
										<div class="modal-content">
											<div class="modal-header">
												<h5 class="modal-title" id="reserveModalLabel{{ offer.id }}">Formulaire de réservation</h5>
												<button type="button" class="close" data-dismiss="modal" aria-label="Close">
													<span aria-hidden="true">&times;</span>
												</button>
											</div>
											<div
												class="modal-body" id="modalBody{{ offer.id }}">
												{# Le formulaire sera chargé ici via AJAX #}
												<div class="text-center">
													<div class="spinner-border" role="status">
														<span class="sr-only">Chargement...</span>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>

{# Ajoutez ce script à la fin du fichier, avant la balise </body> #}
<script>
	function loadReservationForm(offerId) {
const modalBody = document.getElementById(`modalBody${offerId}`);

fetch(`/offre/${offerId}/reserve`, {
headers: {
'X-Requested-With': 'XMLHttpRequest'
}
}).then(response => response.json()).then(data => {
if (data.form) {
modalBody.innerHTML = data.form;

// Ajouter un écouteur pour la soumission du formulaire
const form = document.getElementById(`reservation_form_${offerId}`);
form.addEventListener('submit', function (e) {
e.preventDefault();

const formData = new FormData(form);

fetch(form.action, {
method: 'POST',
body: formData,
headers: {
'X-Requested-With': 'XMLHttpRequest'
}
}).then(response => response.json()).then(data => {
if (data.success) { // Fermer le modal
$(`#reserveModal${offerId}`).modal('hide');

// Afficher un message de succès (vous pouvez personnaliser cela)
alert('Réservation effectuée avec succès!');

// Optionnel : Rafraîchir la page ou mettre à jour les places disponibles
location.reload();
} else { // Recharger le formulaire avec les erreurs de validation
modalBody.innerHTML = data.form;
}
}).catch(error => console.error('Erreur:', error));
});
}
}).catch(error => console.error('Erreur:', error));
}
</script>
